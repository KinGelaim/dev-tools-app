<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

	<aapt:attr name="android:drawable">
		<vector
            android:name="vector"
            android:width="128dp"
            android:height="128dp"
            android:viewportWidth="128"
            android:viewportHeight="128">

			<!-- Фоновая скруглённая плитка -->
			<path
                android:name="bg"
                android:pathData="M 42,22 L 86,22 A 20,20 0 0 1 106,42 L 106,86 A 20,20 0 0 1 86,106 L 42,106 A 20,20 0 0 1 22,86 L 22,42 A 20,20 0 0 1 42,22 Z"
                android:fillColor="#4F46E5"
                android:fillAlpha="0" />

			<!-- Левая скобка < -->
			<path
                android:name="bracket_left"
                android:pathData="M 49,46 L 37,64 L 49,82"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="5.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:trimPathEnd="0" />

			<!-- Слэш / -->
			<path
                android:name="slash"
                android:pathData="M 59,82 L 69,46"
                android:strokeColor="#93C5FD"
                android:strokeWidth="5.5"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />

			<!-- Правая скобка > -->
			<path
                android:name="bracket_right"
                android:pathData="M 79,46 L 91,64 L 79,82"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="5.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:trimPathEnd="0" />

		</vector>
	</aapt:attr>

	<!-- Анимация появления фона (0ms - 350ms) -->
	<target android:name="bg">
		<aapt:attr name="android:animation">
			<objectAnimator
                android:propertyName="fillAlpha"
                android:duration="350"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
		</aapt:attr>
	</target>

	<!-- Отрисовка левой скобки < (150ms - 550ms) -->
	<target android:name="bracket_left">
		<aapt:attr name="android:animation">
			<objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="150"
                android:duration="400"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
		</aapt:attr>
	</target>

	<!-- Отрисовка слэша / (300ms - 650ms) -->
	<target android:name="slash">
		<aapt:attr name="android:animation">
			<objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="300"
                android:duration="350"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
		</aapt:attr>
	</target>

	<!-- Отрисовка правой скобки > (450ms - 850ms) -->
	<target android:name="bracket_right">
		<aapt:attr name="android:animation">
			<objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="450"
                android:duration="400"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
		</aapt:attr>
	</target>

</animated-vector>