<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevToolsApp.ViewModels"
        xmlns:models="using:DevToolsApp.Models"
        x:Class="DevToolsApp.Views.MainView"
        x:DataType="vm:MainViewModel">

    <!-- Добавим сетку: Сверху шапка (Header) с кнопкой-меню, снизу SplitView -->
    <Grid RowDefinitions="Auto, *">
        
        <!-- Верхняя мобильная панель (Шапка) -->
        <Border Grid.Row="0" Background="#2b2d30" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- Кнопка вызова меню -->
                <Button Command="{Binding TogglePaneCommand}" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Padding="8">
                    <PathIcon Data="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2Z" 
                              Width="18" 
                              Height="18" 
                              Foreground="White" />
                </Button>
                
                <TextBlock Text="Инструменты" 
                           VerticalAlignment="Center" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Сам SplitView -->
        <SplitView Grid.Row="1"
                   IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                   DisplayMode="Overlay"
                   OpenPaneLength="250">
            
            <!-- Левая панель со списком -->
            <SplitView.Pane>
                <Border Background="#1e1f22" BorderBrush="#3c3f41" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding Tools}"
                             SelectedItem="{Binding SelectedTool, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Padding="10, 8" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </SplitView.Pane>

            <!-- Основной контент (выбранный инструмент) -->
            <SplitView.Content>
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </SplitView.Content>

        </SplitView>
    </Grid>
</UserControl>