<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevToolsApp.ViewModels"
             x:Class="DevToolsApp.Views.Base64View"
             x:DataType="vm:Base64ViewModel">

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, *" Margin="20">
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Base64 Кодировщик / Декодировщик"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- Панель управления над верхним полем -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
            <TextBlock Text="Входные данные:" FontWeight="Medium" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Вставить" Command="{Binding PasteInputCommand}"/>
                <Button Content="Очистить" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Входной текст -->
        <TextBox Grid.Row="2"
                 Text="{Binding InputText}"
                 PlaceholderText="Введите текст для кодирования или Base64 для декодирования..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"/>

        <!-- Панель действий посередине -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,12">
            <Button Content="Кодировать (Encode)" Command="{Binding EncodeToBase64Command}"/>
            <Button Content="Декодировать (Decode)" Command="{Binding DecodeFromBase64Command}"/>
            <Button Command="{Binding SwapCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z" 
                              Width="14" 
                              Height="14" />
                    <TextBlock Text="Поменять местами" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Панель управления над нижним полем -->
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
            <TextBlock Text="Результат:" FontWeight="Medium" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="{Binding CopyButtonText}"
                    Command="{Binding CopyOutputCommand}"/>
        </Grid>

        <!-- Результат -->
        <TextBox Grid.Row="5"
                 Text="{Binding OutputText}"
                 IsReadOnly="True"
                 PlaceholderText="Здесь появится результат..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"/>
    </Grid>
</UserControl>